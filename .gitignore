Thumbs.db
ehthumbs.db
Desktop.ini

# Claude Code
CLAUDE.md
.claude/
.worktrees/

# Documentation / example projects (not part of firmware)
docs/

# Vendor drops / nested git repos under tools/ — not part of this firmware's history.
# tools/sdio_flasher and tools/slave_firmware are tracked and stay that way.
tools/esp-detection/
tools/esp-dl/
tools/espdet_maritime_deploy/
tools/yolo26n_esp/

# Report generation / output (bao cao NCKH)
tools/report_gen/
report_output/

# User-specific configuration files
*.user
*.workspace # General workspace files, can be from various tools
*.suo       # Visual Studio Solution User Options
*.sln.docstates # Visual Studio
.devcontainer/ # For Visual Studio Code Remote Containers
.vscode/ # For Visual Studio Code settings, extensions, etc.

# Bench throttle-mismatch run data (generated by tools/espnow_drive.py).
# Force-add a specific run if you want to keep it: git add -f tools/bench_logs/T20_BASE_01.csv
tools/bench_logs/

# Pool/lake run data pulled off the boat's SD card. Hundreds of CSVs and tens
# of megabytes, regenerated every session, and the conclusions drawn from them
# live in commit messages and docs rather than in the files themselves.
# Force-add a run if one ever needs to be kept: git add -f dataout/<set>/<file>.CSV
dataout/
