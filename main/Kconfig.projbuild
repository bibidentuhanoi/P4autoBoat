menu "Board Configuration"

    config I2C_SDA_PIN
        int "I2C SDA Pin"
        default 8

    config I2C_SCL_PIN
        int "I2C SCL Pin"
        default 7

    config TOF_A_LPN_PIN
        int "ToF Sensor A LPN Pin"
        default 52

    config TOF_B_LPN_PIN
        int "ToF Sensor B LPN Pin"
        default 29

    config TOF_A_ADDR
        hex "ToF Sensor A Address"
        default 0x22

    config TOF_B_ADDR
        hex "ToF Sensor B Address"
        default 0x24

    config TOF_RANGING_FREQ_HZ
        int "ToF Ranging Frequency (Hz)"
        default 10
        range 1 60
        help
            VL53L5CX ranging frequency in Hz. Lower frequencies allow longer
            integration time for better accuracy on dark/distant targets.
            Must satisfy: integration_time_ms < 1000/freq_hz.

    config TOF_INTEGRATION_TIME_MS
        int "ToF Integration Time (ms)"
        default 10
        range 2 1000
        help
            Time the sensor collects photons per measurement. Longer = lower
            sigma = more accurate, but must fit within the ranging period.

    config TOF_SHARPENER_PERCENT
        int "ToF Sharpener Percent (0=off, 99=max)"
        default 20
        range 0 99
        help
            VL53L5CX sharpener reduces veiling-glare cross-talk, tightening
            each zone's effective angular footprint. 0 = disabled (default 5%
            internally), 50 = recommended for obstacle avoidance. Higher values
            produce crisper zone boundaries but may reduce sensitivity on
            low-reflectance targets.

    config FUSION_COMPLEMENTARY_ALPHA
        string "Fusion Complementary Alpha"
        default "0.96"

    config FUSION_YAW_ALPHA
        string "Yaw gyro/mag complementary weight (0-1, higher = trust gyro more)"
        default "0.98"
        help
            Weight of the gyro in the heading complementary filter. The gyro
            provides the smooth, tilt-immune short-term heading; the magnetometer
            corrects the slow gyro drift with weight (1 - this). 0.98 at 50 Hz
            gives a ~1 s mag-correction time constant.

    config HEADING_DECLINATION_DEG
        string "Magnetic declination (deg, +E / -W) for true north"
        default "0.0"
        help
            Added to the magnetic heading to report TRUE north. Hanoi is ~0 deg,
            so the default 0.0 is fine. Look up your local declination if needed.

    config CALIB_GYRO_SAMPLES
        int "Gyro Calibration Samples"
        default 500

    config CALIB_MAG_DURATION
        int "Mag Calibration Duration (s)"
        default 15


    menu "Camera Configuration"

        config CAM_SCCB_SCL_PIN
            int "Camera SCCB SCL Pin"
            default 8
            help
                SCL pin for camera SCCB (I2C_NUM_0). Reversed from sensor bus (I2C_NUM_1 SCL=7).

        config CAM_SCCB_SDA_PIN
            int "Camera SCCB SDA Pin"
            default 7
            help
                SDA pin for camera SCCB (I2C_NUM_0). Reversed from sensor bus (I2C_NUM_1 SDA=8).

        config CAM_RESET_PIN
            int "Camera Reset Pin (-1 = not used)"
            default -1

        config CAM_PWDN_PIN
            int "Camera Power-Down Pin (-1 = not used)"
            default -1

        config CAM_XCLK_PIN
            int "Camera XCLK Pin (-1 = not used)"
            default -1

        config CAM_XCLK_FREQ_HZ
            int "Camera XCLK Frequency (Hz)"
            default 24000000

        config CAM_VFLIP
            int "Camera Vertical Flip (0=off, 1=on)"
            default 1

        config CAM_HFLIP
            int "Camera Horizontal Flip (0=off, 1=on)"
            default 1

        config CAM_JPEG_QUALITY
            int "JPEG Compression Quality (1-100)"
            default 60
            range 1 100
            help
                JPEG encoding quality for the MJPEG stream.
                Lower values = smaller frames, less bandwidth.
                Higher values = better image quality, more bandwidth.

    endmenu

    menu "ESC Motor Configuration"

        config ESC_PWM_LEFT_PIN
            int "Left ESC PWM Pin (ESPWM_L)"
            default 31

        config ESC_PWM_RIGHT_PIN
            int "Right ESC PWM Pin (ESPWM_R)"
            default 33

        config ESC_PWM_FREQ_HZ
            int "ESC PWM Frequency (Hz)"
            default 50
            help
                Standard RC ESC expects 50 Hz (20 ms period).

        config ESC_PULSE_MIN_US
            int "ESC Pulse Min (us) — full reverse / arm"
            default 1000
            range 500 1500

        config ESC_PULSE_MAX_US
            int "ESC Pulse Max (us) — full forward"
            default 2000
            range 1500 2500

        config ESC_PULSE_NEUTRAL_US
            int "ESC Pulse Neutral (us) — stopped"
            default 1500
            range 1000 2000

        config STABILITY_TRIMLEARN_ENABLE
            bool "Learn the L/R trim on the fly from the gyro"
            default y
            help
                Continuously adjusts ONE number c, the differential split as a
                FRACTION of throttle (split = c * throttle), so the correction
                rescales itself when the throttle changes. Integrator only --
                direction of drift, never magnitude -- with a deadband, and
                frozen while steering, at low throttle, disarmed, on a stale
                gyro, and through a bench run or an ESC calibration.

                It moves the motors on its own, so the bounds matter: c is held
                to [0.10, 0.35] and may move at most 0.005/s, and touching
                either bound is treated as a FAULT that latches and stops --
                wrong sign, blocked jet or bad gyro all land there rather than
                sitting on the rail pretending to work.

                Starts at ESC_TRIM_C, so switching it off changes nothing until
                it has learned something. The drift-to-correction SIGN is not a
                guess: 11 dataset groups on this boat agree that too little
                trim reads negative yaw and too much reads positive.

                Set to n to run the flashed ESC_TRIM_C fixed.

        config STABILITY_PASSIST_KP
            string "P-assist: c per deg/s of yaw"
            default "0.035"
            depends on STABILITY_TRIMLEARN_ENABLE
            help
                A TEMPORARY proportional correction added on top of the learned
                c. Never stored, never learned, reset the instant its gates stop
                holding. Switched on at RUNTIME (default off) so the A and B
                arms of an experiment run the same firmware.

                The measured plant is 16.1 deg/s per unit c, so unity loop gain
                would be 0.062. 0.035 is ~56% of that.

                0.020 was the first candidate, but simulating the real recorded
                traces through the measured 1.10 s hull lag showed it reaching
                only -12% of heading error inside a 3 s run, against a -20% bar.
                0.035 reaches -24%, with no measurable rise in high-frequency
                yaw (the hull's own lag filters P's output).

                ROBUST TO THE LAKE. The pool is only the proving ground; at
                speed the hull is more directionally stable, so the plant gain
                and lag both change. Swept against the real traces:

                    plant      hull 0.5s  hull 1.1s  hull 2.5s
                     5.0 deg/s     -13%      -13%       -11%
                    10.0           -24%      -23%       -20%
                    16.1 (pool)    -34%      -32%       -29%
                    25.0           -45%      -44%       -39%

                It helps everywhere and never flips sign. Loop gain stays
                0.18-0.88, under unity across the whole range, so a P-only loop
                on a first-order plant cannot oscillate -- and the cap bounds
                what it can do even if the plant is further off than this.

        config STABILITY_PASSIST_TAU_S
            string "P-assist: fast yaw filter time constant (s)"
            default "0.25"
            depends on STABILITY_TRIMLEARN_ENABLE
            help
                Set by the HULL, not by taste. The measured yaw response to a
                motor step is a 1.10 s time constant with ~0.3 s of dead time
                (untrimmed T40 runs). A filter faster than the hull chases gyro
                noise the boat cannot follow: at 0.15 s the correction sits at
                its cap 30% of the time on noise alone, against 17% at 0.50 s.

                But the POOL caps a run at 3 s, and P's correction only reaches
                the yaw after the filter plus the 1.10 s hull lag. Simulated on
                90 real runs, 0.50 s left too little of the run to act in:

                    tau   0.2-2.0s  1.0-3.0s window
                    0.15     -11%      -21%
                    0.25     -10%      -21%
                    0.50      -6%      -19%
                    1.00      -0%      -14%

                0.25 s buys the response back without measurably raising
                high-frequency yaw. Below 0.25 s nothing further is gained --
                the hull cannot follow it.

                On the LAKE this choice barely matters: with continuous running
                the loop reaches steady state and 0.15 / 0.25 / 0.50 / 1.00 all
                give -31 to -32%. 0.25 is picked purely so the 3 s POOL test
                has margin above its bar (-24% vs -20% at 0.50 s). The pool is
                the proving ground, not the target.

        config STABILITY_PASSIST_CAP
            string "P-assist: max |correction| in c units"
            default "0.075"
            depends on STABILITY_TRIMLEARN_ENABLE
            help
                0.075 of c moves each motor by at most 3.0 percentage points at
                T40 and can cancel about 1.2 deg/s of yaw.

                Chosen as the smallest cap that is NOT limiting: simulated on
                90 real runs, 0.030 gave -15% (saturated 51% of the time),
                0.050 gave -21% (28%), and 0.075 gave -24% (9%). Raising it
                further to 0.100 or removing it entirely still gives -24%, so
                past 0.075 the cap costs nothing and protects less.

        config STABILITY_TRIMLEARN_DEADBAND_DPS
            string "TrimLearn: ignore drift below this (deg/s)"
            default "0.5"
            depends on STABILITY_TRIMLEARN_ENABLE

        config STABILITY_TRIMLEARN_STEP_PER_S
            string "TrimLearn: max change in c per second"
            default "0.005"
            depends on STABILITY_TRIMLEARN_ENABLE

        config STABILITY_TRIMLEARN_MIN_THROTTLE
            string "TrimLearn: freeze below this throttle"
            default "0.15"
            depends on STABILITY_TRIMLEARN_ENABLE

        config ESC_TRIM_C
            string "L/R trim as a FRACTION of throttle (the one number)"
            default "0.17"
            help
                split = c * throttle, so left = T*(1-c) and right = T*(1+c).
                POSITIVE gives the RIGHT motor more.

                This is the whole trim in one dimensionless number, and it is
                what the bench measured. The split that makes the boat go
                straight is NOT constant -- 2.3% at T10, 6.5% at T30, 7.0% at
                T35, 7.5% at T40 -- but split/throttle is: 0.23, 0.22, 0.20,
                0.19. So one c covers 10-50%.

                A flat trim cannot do that. 0.152 (the T40 answer) was flashed
                and verified at T30/T40/T45, then read +8.4 deg/s at T10 --
                over-corrected by 4x because a fixed number does not rescale.

                0.17 +/- 0.035, and that error bar is real -- it is the
                measurement limit, not a slicing choice.

                Found by bracketing the SIGN FLIP, no line fitted: bin all 63
                adaptive runs by the c they ran with, and find the pair of bins
                where median yaw changes sign. Twelve independent slices (five
                time windows, two sessions, three throttles) give 0.145, 0.155,
                0.160, 0.162, 0.165, 0.167, 0.168, 0.175, 0.182, 0.195, 0.203,
                0.212. Median 0.171.

                The two cleanest windows agree closely: 0.5-2.0 s (after
                spin-up, before the hull reaches the pool wall) gives 0.165 and
                3.0-10 s gives 0.168.

                Note the band contains both 0.16 and 0.20, so this data cannot
                tell those apart. It CAN say the answer is near 0.17 and that
                0.24 and above is measurably too much. Per throttle it is
                0.162 / 0.203 / 0.145 at T20 / T30 / T40 -- no trend, which is
                what the one-number model predicts.

                Above ~83% throttle the mixer runs out of headroom (it will not
                clip the pilot's command to make room for trim), so the trim
                tapers there. It is untouched over the whole 10-50% range.

                Wins over both ESC_TRIM_DEFAULT and any NVS table.
                Set "0.0" to fall back to those.

        config ESC_TRIM_DEFAULT
            string "FLAT fallback trim (only when ESC_TRIM_C is 0)"
            default "0.152"
            help
                esc_trim_mix units: left -= trim/2, right += trim/2, so a
                POSITIVE value gives the RIGHT motor more.

                0.152 = right +7.6%, measured 2026-08-25 at T40. Correct AT T40
                and wrong everywhere else -- kept only so the flat behaviour can
                be reproduced for comparison. Prefer ESC_TRIM_C.

                Used only when ESC_TRIM_C is "0.0". Set "0.0" to fall back to
                the NVS table.

        config ESC_MIN_THR_LEFT_PCT
            int "Left ESC minimum-thrust floor (% throttle where the LEFT jet just starts)"
            default 5
            range 0 95
            help
                Measured left-jet dead-band. Zero remains off; positive throttle
                begins at this fraction of the usable ESC pulse span.

        config ESC_MIN_THR_RIGHT_PCT
            int "Right ESC minimum-thrust floor (% throttle where the RIGHT jet just starts)"
            default 19
            range 0 95
            help
                Measured right-jet dead-band. Tune each motor in water so equal
                normalized commands produce comparable thrust.

    endmenu

    menu "Manual Heading Assist"

        config HEADING_ASSIST_DRY_RUN
            int "Heading assist dry-run mode (1=log only, 0=off)"
            default 1
            range 0 1
            help
                Bench-safe heading-hold experiment mode. When enabled, firmware
                computes target heading, heading error, yaw-rate damping,
                adaptive rudder trim, rudder assist, and small differential
                thrust, then logs CTRL_DRY lines. It does NOT apply those
                corrections to the rudder or ESCs.

        config HEADING_ASSIST_BAND_DEG
            string "Heading assist deadband around target (deg)"
            default "4.0"
            help
                Half-width of the quiet heading window. A value of 4.0 means a
                target heading of 245 accepts 241..249 before proportional
                correction starts. Yaw damping can still act inside the band.

        config HEADING_ASSIST_CAPTURE_DELAY_MS
            int "Heading assist target capture delay after centered rudder (ms)"
            default 500
            range 100 3000
            help
                After the pilot releases the rudder to center, wait this long
                before capturing the current fused heading as the target.

        config HEADING_ASSIST_RUDDER_DEADBAND
            string "Manual rudder center deadband for heading capture"
            default "0.08"
            help
                Absolute normalized rudder input below this value counts as
                centered. Above it, pilot override disables heading hold.

        config HEADING_ASSIST_MAX_RUDDER
            string "Maximum computed rudder assist"
            default "0.25"
            help
                Hard cap for dry-run rudder correction in normalized rudder
                units. This is only logged while dry-run mode is enabled.

        config HEADING_ASSIST_MAX_DIFF
            string "Maximum computed differential thrust assist"
            default "0.06"
            help
                Hard cap for dry-run differential thrust in normalized ESC
                units. This is only logged while dry-run mode is enabled.

        config STABILITY_SAS_ENABLE
            bool "Enable live rudder yaw-rate stabilizer (actuates the rudder)"
            default n
            help
                OFF leaves manual steering unchanged. ON applies the capped
                yaw-rate loop only while armed, linked, and IMU healthy. It
                controls the rudder only; ESC commands remain manual.

        config STABILITY_SAS_RMAX_DPS
            int "SAS: yaw-rate at full stick (deg/s)"
            default 45
            range 5 180

        config STABILITY_SAS_KR
            string "SAS: rudder per deg/s of rate error"
            default "0.010"

        config STABILITY_SAS_YAW_TAU_S
            string "SAS: yaw-rate low-pass time constant (seconds)"
            default "0.15"
            help
                Time constant, not a per-sample blend fraction -- the effective
                filter stays the same even if the fusion tick rate changes.

        config STABILITY_SAS_OUT_CAP
            string "SAS: max rudder authority (0..1)"
            default "0.50"

        config STABILITY_SAS_MAX_AGE_MS
            int "SAS: max fusion-data age before centring the rudder (ms)"
            default 200
            range 50 2000
            help
                If the newest FusionResult is older than this, treat fusion as
                stalled: reset the controller and centre the rudder rather than
                holding the last command forever. Independent of the 400ms
                control-link failsafe -- this catches a hung SENSOR task even
                while the control LINK stays alive.

        comment "ESC differential-trim auto-calibration (triggered from a dashboard; runs only while armed+linked)"

        config STABILITY_TRIMCAL_KI
            string "TrimCal: integrator gain (trim per deg/s per second)"
            default "0.02"
            help
                Slow integrator that settles onto the L/R differential which
                nulls yaw. Small: this is a converge-then-record search, not a
                fast loop.

        config STABILITY_TRIMCAL_CLAMP
            string "TrimCal: max differential trim before abort (0..1)"
            default "0.30"
            help
                Guard rail. Hitting it means the feedback sign is wrong or the
                imbalance is beyond trim -- the sweep aborts and saves nothing
                (the wrong-sign fail-safe).

        config STABILITY_TRIMCAL_ACCEPT_K
            string "TrimCal: accept-band sigma multiple"
            default "3.0"
            help
                A level records once the windowed mean yaw sits within
                k*sigma/sqrt(N) of zero, where sigma is the boat's own measured
                stationary gyro noise.

        config STABILITY_TRIMCAL_MIN_SPEED_MPS
            string "TrimCal: minimum GPS ground speed to record (m/s)"
            default "0.3"
            help
                Making-way gate: rudder-less yaw balance is only meaningful while
                the boat is actually moving.

        config STABILITY_TRIMCAL_MAX_YAW_DPS
            int "TrimCal: excessive-yaw abort threshold (deg/s)"
            default 45
            range 5 180
            help
                Its OWN value, deliberately NOT reused from SAS RMAX: calibration
                runs with SAS suppressed and must not inherit a dependency on how
                the pilot's stick feel was tuned.

        config STABILITY_TRIMCAL_WINDOW_TICKS
            int "TrimCal: convergence-window length (control ticks, 100 Hz)"
            default 100
            range 10 1000

        config STABILITY_TRIMCAL_NOISE_TICKS
            int "TrimCal: stationary noise/bias measurement window (control ticks)"
            default 100
            range 10 1000

        config STABILITY_TRIMCAL_SETTLE_MS
            int "TrimCal: settle wait after a throttle step before integrating (ms)"
            default 400
            range 0 5000

        config STABILITY_TRIMCAL_LEVEL_TIMEOUT_MS
            int "TrimCal: per-level give-up timeout (ms)"
            default 15000
            range 1000 60000

    endmenu

    menu "Winch / Servo Configuration"

        config WINCH_PWM_PIN
            int "Winch Servo PWM Pin (dual-use with BOOT button)"
            default 35
            help
                GPIO for the winch servo PWM. Shared with the BOOT/recalibration
                button: read as a button during the 3 s boot window, then
                reconfigured as an MCPWM output.

        config WINCH_PWM_FREQ_HZ
            int "Winch PWM Frequency (Hz)"
            default 50

        config WINCH_PULSE_MIN_US
            int "Winch Pulse Min (us) — full CCW / up"
            default 1000
            range 500 1500

        config WINCH_PULSE_NEUTRAL_US
            int "Winch Pulse Neutral (us) — stop (trim for your servo)"
            default 1500
            range 1000 2000

        config WINCH_PULSE_MAX_US
            int "Winch Pulse Max (us) — full CW / down"
            default 2000
            range 1500 2500

        config WINCH_DEADBAND_US
            int "Winch dead-band (us) — servo neutral zone to skip past"
            default 45
            range 0 300
            help
                Continuous-rotation servos ignore pulses within this many us of
                neutral (the winch didn't move until ~9% slider = ~45us). Any
                non-zero speed command jumps straight past this, so the winch
                responds at the very bottom of the slider. Trim so the smallest
                slider motion just barely starts the servo (raise if the bottom
                of the slider still does nothing; lower if it creeps at zero).

        config SERVO_ENABLE_PIN
            int "Servo Power Enable Pin"
            default 36

        config SERVO_ENABLE_ACTIVE_LOW
            bool "Servo Enable is Active-Low"
            default n
            help
                Enable if the servo power MOSFET/relay conducts when the pin is LOW.

        config STATUS_LED_PIN
            int "User Status LED Pin (calibration indicator)"
            default 3
            help
                GPIO for the user LED that signals the boot-button calibration
                window and which calibration phase is running. Dark otherwise.

        config STATUS_LED_ACTIVE_LOW
            bool "Status LED is Active-Low"
            default n
            help
                Enable if the LED lights when the pin is driven LOW (cathode to
                the pin, anode to 3V3).

        config STEER_PIN
            int "Rudder Servo PWM Pin (both rudders share this one signal)"
            default 32
            help
                Single unified rudder output. A boat has ONE steering axis, so
                both rudder servos take this same signal and always deflect
                together — independent (split) rudders cost complexity with no
                steering benefit, and a planner only ever wants one steering
                value. Wire both servo signal leads to this pin (each keeps its
                own + and GND). Both rudder servos are wired to GPIO32 on this
                board (moved off GPIO34 — 2026-08-04, confirmed via live PWM
                math checking out on 34 while nothing physically moved).

        config STEER_PWM_FREQ_HZ
            int "Steering PWM Frequency (Hz)"
            default 50

        config STEER_PULSE_MIN_US
            int "Steering Pulse Min (us) — full left"
            default 1195
            range 500 1500
            help
                Full-left mechanical stop, found 2026-08-04 by direct probe via
                the dashboard's raw-pulse calibration box (bypasses this value
                entirely, so a wrong number here can't hide the true stop) —
                walked down from 1000 until the servo hit its real limit. The
                old 1000 default predates the GPIO34->32 rewiring and was never
                actually verified against this wiring. Slider +100 maps here
                (dashboard.html negates the slider at its own JS boundary, so
                -100 lines up with STEER_HOME/full-right instead -- this text
                used to say "-100 maps here", true only before that negation
                existed).

        config STEER_PULSE_NEUTRAL_US
            int "Steering Pulse Neutral (us) — centered"
            default 1516
            range 1195 1805
            help
                Calibrated: the rudder points dead-ahead at 1516us on this hull,
                found the same way as STEER_PULSE_MIN_US 2026-08-04. Close to but
                not exactly the arithmetic midpoint of MIN/MAX (1500) — hobby
                servos aren't perfectly symmetric between their end-stops, and/or
                the horn isn't mounted at true mid-travel. Slider 0 maps here —
                nudge a few us if straight-ahead drifts.

        config STEER_PULSE_MAX_US
            int "Steering Pulse Max (us) — full right"
            default 1805
            range 1500 2500
            help
                Calibrated hard limit: at 1805us the servo reaches its mechanical
                rotation stop (it physically hits something). Do NOT raise past
                this — anything higher just stalls the servo against the stop.
                Slider +100 maps here.

        config STEER_REVERSE
            bool "Reverse Rudder Direction"
            default n
            help
                Flip if the rudders deflect the wrong way for a given command.
                Both servos share one signal, so they must be mounted to deflect
                the same way — if only ONE is backwards, mirror it mechanically
                (flip its horn/linkage); this flag inverts both together.

    endmenu

    menu "GPS Configuration"

        config GPS_UART_NUM
            int "GPS UART peripheral number"
            default 1
            range 1 4

        config GPS_RX_PIN
            int "GPS UART RX Pin (MCU receive, = GPS TX)"
            default 38
            help
                Swapped from 37 2026-08-05: traced uart_set_pin(uart, tx_pin,
                rx_pin, ...) against the real ESP-IDF signature (tx_io_num is
                the 2nd param, rx_io_num the 3rd) and confirmed the old 37/38
                assignment had MCU RX and TX backwards relative to the actual
                wiring (GPS module's RX wire lands on GPIO37 on this board, so
                GPIO37 must be the MCU's TX, not its RX).

        config GPS_TX_PIN
            int "GPS UART TX Pin (MCU transmit, = GPS RX)"
            default 37

        config GPS_BAUD
            int "GPS UART Power-on Baud Rate"
            default 9600
            help
                The baud the module boots at (u-blox default 9600). The driver
                sends UBX CFG-PRT at this baud, then switches to GPS_HIGH_BAUD.

        config GPS_HIGH_BAUD
            int "GPS UART Target Baud Rate (after UBX config)"
            default 115200
            help
                Baud the driver switches the u-blox module to so NAV-PVT fits at
                the configured rate. 9600 cannot carry NAV-PVT at 10 Hz.

        config GPS_MEAS_RATE_HZ
            int "GPS Measurement Rate (Hz)"
            default 10
            range 1 10
            help
                u-blox nav-solution rate (UBX CFG-RATE). NEO-M8N supports up to 10 Hz.

    endmenu

    menu "WiFi Configuration"

        config WIFI_SSID
            string "WiFi SSID"
            default "Bi Bop"

        config WIFI_PASSWORD
            string "WiFi Password"
            default "0903875378"

        config HTTP_API_PORT
            int "HTTP API/Dashboard Port"
            default 80

        config HTTP_STREAM_PORT
            int "HTTP MJPEG Stream Port"
            default 81

    endmenu

endmenu

menu "ESP-NOW Field Mode"

    config ESPNOW_ENABLED
        bool "Enable ESP-NOW field mode"
        default y

    config ESPNOW_PROBE_MS
        int "Ground-station probe window at boot (ms)"
        default 2500
        range 600 30000
        depends on ESPNOW_ENABLED
        help
            At boot the boat listens this long for a MSG_GROUND_HELLO beacon
            from the ESP32-S3 USB bridge. Heard -> ESP-NOW field mode; silence
            -> connect to WiFi instead.

            The S3 beacons every 500 ms, so this must be comfortably larger
            than 500 to avoid landing in the gap between two beacons. 2500 ms
            gives ~5 chances while adding only ~2.5 s to a WiFi boot.

    config ESPNOW_WIFI_TIMEOUT_S
        int "WiFi connect timeout before ESP-NOW fallback (seconds)"
        default 10
        depends on ESPNOW_ENABLED
        help
            DEPRECATED / UNUSED. Kept only so existing sdkconfigs do not break.
            Mode is now chosen by the ESP-NOW probe above, not by a WiFi
            timeout. The WiFi connect timeout itself is
            WIFI_CONNECT_TIMEOUT_MS in wifi_manager.c.



    config ESPNOW_CHANNEL
        int "ESP-NOW WiFi channel"
        default 6
        range 1 14
        depends on ESPNOW_ENABLED

    config ESPNOW_PEER_MAC
        string "ESP32-S3 bridge MAC address (hex, colon-separated)"
        default "FF:FF:FF:FF:FF:FF"
        depends on ESPNOW_ENABLED

endmenu
